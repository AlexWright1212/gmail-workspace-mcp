# Optional: override the default config directory (~/.gmail-multi-mcp)
GMAILMCPCONFIG_DIR=/Users/tyler/.gmail-multi-mcp

# Optional: force the HTTP transport instead of stdio. "sse" is the historical
# spelling and still works; the /sse endpoint itself was deleted in Phase 4.
MCP_TRANSPORT=http

# REQUIRED for the HTTP transport: the self-hosted OAuth 2.1 authorization
# server (docs/adr/013-self-hosted-oauth-google-upstream.md). All three must be
# set together — since Phase 4 deleted the shared bearer token this is the only
# way a client can authenticate, so the server REFUSES TO START on HTTP without
# them rather than raising an endpoint nobody can use.
# PUBLIC_URL must be the permanent public hostname from ADR 012.
# GOOGLE_LOGIN_CLIENT_ID/SECRET are the SECOND, previously-unused GCP web
# OAuth client in project email-503620 (see CLAUDE.md "Environment") — its
# redirect URI must be set in GCP Console to
# "${PUBLIC_URL}/oauth/google/callback" before this works.
PUBLIC_URL=https://mcp.example.com
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
